{
  "imports": {
    "@hono/zod-openapi": "npm:@hono/zod-openapi@^1.6.3",
    "@needle-di/core": "jsr:@needle-di/core@^1.2.1",
    "@scalar/hono-api-reference": "npm:@scalar/hono-api-reference@^0.12.2",
    "@modelcontextprotocol/server": "npm:@modelcontextprotocol/server@^2.0.0",
    "hono": "npm:hono@^4.13.8",
    "zod": "npm:zod@^4.6.5"
  },
  "permissions": {
    "default": {
      "env": true,
      "read": true,
      "net": true
    },
    "development": {
      "env": true,
      "read": true,
      "net": true
    }
  },
  "deploy": {
    "runtime": {
      "entrypoint": "src/main.ts"
    }
  },
  "tasks": {
    "dev": "deno run --permission-set=development --env --watch src/main.ts",
    "debug": "deno run --inspect-wait --permission-set=development --env --watch src/main.ts",
    "check": "deno check src/main.ts"
  }
}
