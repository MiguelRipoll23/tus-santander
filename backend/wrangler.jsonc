{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tus",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./static",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "TUS_API_BASE_URL": "https://tus.redparsec.com"
  }
}
